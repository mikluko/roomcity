{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["gomod", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "gc, pinned to a commit of a branch in the Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=git-refs depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\nARG \\S+=(?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "git-refs"
    }
  ]
}
